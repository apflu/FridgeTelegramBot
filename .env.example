# Credentials for any OpenAI-compatible service
OPENAI_API_KEY=your_api_key_here
# Base URL: leave blank for official OpenAI, or point to any OpenAI-compatible endpoint, e.g.:
#   Gemini     : https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq       : https://api.groq.com/openai/v1
#   local/proxy: http://localhost:11434/v1
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini
# Vision model for receipt recognition; leave blank to fall back to OPENAI_MODEL (must be multimodal)
# OPENAI_VISION_MODEL=
# Display currency for receipt amounts (display only; stored internally in cents)
# CURRENCY=€
# Output format strategy: blank/false = json_object (schema described in prompt, widest endpoint support);
# true = json_schema constrained decoding (stronger format guarantee, requires endpoint support, e.g. Gemini / OpenAI)
# LLM_STRUCTURED_OUTPUT=false

TELEGRAM_BOT_TOKEN=bot_token_from_botfather
TELEGRAM_OWNER_ID=your_telegram_user_id
# optional: maintained inventory message is posted/edited here
# - private channel: numeric id like -1001234567890
# - public channel: @your_channel_username
# - leave blank to disable channel (DM-only)
TELEGRAM_CHANNEL_ID=

# DB_PATH=fridge.db
# DAILY_REFRESH_HOUR=8

# 任意 OpenAI 兼容服务的凭证
OPENAI_API_KEY=your_api_key_here
# 入口地址：留空=官方 OpenAI；也可指向任意 OpenAI 兼容端点，例如：
#   Gemini  : https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq    : https://api.groq.com/openai/v1
#   本地/网关: http://localhost:11434/v1
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini
# 收据识别用的视觉模型，留空则回退 OPENAI_MODEL（需多模态能力）
# OPENAI_VISION_MODEL=
# 收据金额展示币种（仅影响显示，内部始终按分存储）
# CURRENCY=€

TELEGRAM_BOT_TOKEN=bot_token_from_botfather
TELEGRAM_OWNER_ID=your_telegram_user_id
# optional: maintained inventory message is posted/edited here
# - private channel: numeric id like -1001234567890
# - public channel: @your_channel_username
# - leave blank to disable channel (DM-only)
TELEGRAM_CHANNEL_ID=

# DB_PATH=fridge.db
# DAILY_REFRESH_HOUR=8
